# ============================================
# LlamaIndex 智能数据分析平台 - 环境变量配置
# ============================================
# 复制本文件为 .env 并填入实际值：
# cp .env.example .env
# ============================================

# ============================================
# 数据库配置（PostgreSQL）
# ============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=knowledge_base
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password

# ============================================
# MinIO 对象存储配置
# ============================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=remember

# ============================================
# JWT 认证配置
# ============================================
# 建议生成随机字符串：openssl rand -hex 32
JWT_SECRET_KEY=rag-ai-platform-jwt-secret-key-2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================
# LLM API 配置（必填）
# ============================================
# 阿里云 DashScope（百炼）API Key
# 用于：文本生成、向量嵌入、图片理解
# 获取地址：https://help.aliyun.com/zh/dashscope/
DASHSCOPE_APIKEY=sk-your-dashscope-api-key-here

# ============================================
# 日志级别
# ============================================
LOG_LEVEL=INFO
